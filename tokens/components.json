{
  "control": {
    "height-sm": "2.5rem",
    "height-md": "2.75rem",
    "height-lg": "3rem",
    "radius": "{radius.sm}",
    "focus-width": "2px",
    "focus-offset": "2px"
  },
  "button": {
    "padding-inline-sm": "{space.3}",
    "padding-inline-md": "{space.4}",
    "padding-inline-lg": "{space.6}",
    "font-family": "{font.sans}",
    "font-weight": "600",
    "font-size-sm": "0.875rem",
    "font-size-md": "0.9375rem",
    "gap": "{space.2}",
    "disabled-opacity": "0.55"
  },
  "icon": {
    "size": "1em"
  },
  "panel": {
    "padding": "{space.6}",
    "radius": "{radius.lg}"
  },
  "content": {
    "measure": "68ch",
    "wide": "73.75rem"
  },
  "wordmark": {
    "font-family": "{font.sans}",
    "open-weight": "500",
    "open-tracking": "-0.01em",
    "e2ee-weight": "800",
    "e2ee-tracking": "-0.015em",
    "small-weight": "600",
    "small-tracking": "-0.01em",
    "small-maximum-size": "13px"
  },
  "heading": {
    "font-family": "{font.sans}",
    "weight": "700",
    "tracking-display": "-0.015em",
    "tracking-text": "0",
    "display-minimum-size": "24px"
  },
  "prose": {
    "font-family": "{font.serif}",
    "weight": "400",
    "line-height": "1.7",
    "measure": "68ch",
    "pull-quote-weight": "500",
    "pull-quote-optical-size": "36"
  },
  "code": {
    "font-family": "{font.mono}",
    "weight": "400",
    "size": "0.84375rem",
    "line-height": "1.65",
    "inline-size": "0.92em"
  },
  "metadata": {
    "font-family": "{font.mono}",
    "weight": "500",
    "size": "0.75rem",
    "tracking": "0.02em"
  },
  "diagram": {
    "open-stroke-width": "4px",
    "arrow-width": "2px",
    "boundary-gutter": "48px",
    "boundary-dash": "2 6",
    "metadata-tick-width": "2px",
    "metadata-tick-length": "10px"
  }
}
