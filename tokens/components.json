{
  "control": {
    "height-sm": "2.5rem",
    "height-md": "2.75rem",
    "height-lg": "3rem",
    "radius": "{radius.sm}",
    "focus-width": "2px",
    "focus-offset": "2px"
  },
  "button": {
    "padding-inline-sm": "{space.3}",
    "padding-inline-md": "{space.4}",
    "padding-inline-lg": "{space.6}",
    "font-family": "{font.sans}",
    "font-weight": "600"
  },
  "panel": {
    "padding": "{space.6}",
    "radius": "{radius.lg}"
  },
  "content": {
    "measure": "68ch",
    "prose": "72ch",
    "wide": "73.75rem"
  },
  "diagram": {
    "open-stroke-width": "4px",
    "arrow-width": "2px",
    "boundary-gutter": "48px",
    "boundary-dash": "2 6",
    "metadata-tick-width": "2px",
    "metadata-tick-length": "10px"
  }
}
