{
  "control": {
    "height-sm": "2.5rem",
    "height-md": "2.75rem",
    "height-lg": "3rem",
    "radius": "{radius.sm}",
    "focus-width": "3px",
    "focus-offset": "3px"
  },
  "button": {
    "padding-inline-sm": "{space.3}",
    "padding-inline-md": "{space.4}",
    "padding-inline-lg": "{space.6}",
    "font-family": "{font.mono}"
  },
  "panel": {
    "padding": "{space.6}",
    "radius": "{radius.lg}"
  },
  "content": {
    "measure": "72ch",
    "wide": "73.75rem"
  }
}

