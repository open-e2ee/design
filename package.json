{
  "name": "@open-e2ee/design",
  "version": "0.9.1",
  "description": "OpenE2EE brand assets, design tokens, theming, and design guidance.",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "DESIGN.md",
    "LICENSE",
    "LICENSE-BRAND.md",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "brand/third-party/",
    "docs/",
    "packages/design/bin/",
    "packages/design/dist/"
  ],
  "exports": {
    ".": {
      "types": "./packages/design/dist/index.d.ts",
      "default": "./packages/design/dist/index.mjs"
    },
    "./tokens": "./packages/design/dist/tokens.json",
    "./tokens.css": "./packages/design/dist/css/tokens.css",
    "./fonts.css": "./packages/design/dist/css/fonts.css",
    "./wordmark.css": "./packages/design/dist/css/wordmark.css",
    "./components.css": "./packages/design/dist/css/components.css",
    "./tailwind.css": "./packages/design/dist/css/tailwind.css",
    "./theme": {
      "types": "./packages/design/dist/theme.d.ts",
      "default": "./packages/design/dist/theme.mjs"
    },
    "./assets/*": "./packages/design/dist/assets/*",
    "./diagram": {
      "types": "./packages/design/dist/diagram.d.ts",
      "default": "./packages/design/dist/diagram.mjs"
    },
    "./taglines": {
      "types": "./packages/design/dist/taglines.d.ts",
      "default": "./packages/design/dist/taglines.mjs"
    },
    "./icons": {
      "types": "./packages/design/dist/icons.d.ts",
      "default": "./packages/design/dist/icons.mjs"
    }
  },
  "bin": {
    "oe-design": "./packages/design/bin/oe-design.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "check": "npm run build && npm test && git diff --exit-code -- brand/generated/*.svg brand/generated/svg brand/generated/social/*.svg brand/generated/lockup packages/design/dist/assets/*.svg packages/design/dist/assets/svg packages/design/dist/assets/social/*.svg packages/design/dist/assets/lockup packages/design/dist/css packages/design/dist/index.d.ts packages/design/dist/index.mjs packages/design/dist/theme.d.ts packages/design/dist/theme.mjs packages/design/dist/diagram.d.ts packages/design/dist/diagram.mjs packages/design/dist/taglines.d.ts packages/design/dist/taglines.mjs packages/design/dist/icons.d.ts packages/design/dist/icons.mjs packages/design/dist/tokens.json",
    "pack:check": "npm pack --dry-run --json",
    "prepack": "npm run build && npm test"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
